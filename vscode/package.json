{
  "name": "ardudebug",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "NikolaiRadke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NikolaiRadke/ArduDebug"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.ino",
    "onLanguage:cpp",
    "onDebugResolve:ardudebug"
  ],
  "contributes": {
    "configurationDefaults": {
      "files.associations": {
        "*.ino": "cpp"
      }
    },
    "commands": [
      {
        "command": "ardudebug.debug",
        "title": "%command.debug%",
        "category": "ArduDebug",
        "icon": "$(debug-alt)"
      },
      {
        "command": "ardudebug.compile",
        "title": "%command.compile%",
        "category": "ArduDebug",
        "icon": "$(check)"
      },
      {
        "command": "ardudebug.upload",
        "title": "%command.upload%",
        "category": "ArduDebug",
        "icon": "$(arrow-right)"
      },
      {
        "command": "ardudebug.monitor",
        "title": "%command.monitor%",
        "category": "ArduDebug",
        "icon": "$(output)"
      },
      {
        "command": "ardudebug.selectBoard",
        "title": "%command.selectBoard%",
        "category": "ArduDebug"
      },
      {
        "command": "ardudebug.selectPort",
        "title": "%command.selectPort%",
        "category": "ArduDebug"
      },
      {
        "command": "ardudebug.selectBaudrate",
        "title": "%command.selectBaudrate%",
        "category": "ArduDebug"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "submenu": "ardudebug.menu",
          "when": "resourceExtname == .ino",
          "group": "navigation@1"
        }
      ],
      "ardudebug.menu": [
        {
          "command": "ardudebug.compile",
          "group": "1_build@1"
        },
        {
          "command": "ardudebug.upload",
          "group": "1_build@2"
        },
        {
          "command": "ardudebug.debug",
          "group": "1_build@3"
        },
        {
          "command": "ardudebug.monitor",
          "group": "2_monitor@1"
        },
        {
          "command": "ardudebug.selectBoard",
          "group": "3_config@1"
        },
        {
          "command": "ardudebug.selectPort",
          "group": "3_config@2"
        },
        {
          "command": "ardudebug.selectBaudrate",
          "group": "3_config@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ardudebug.debug",
        "key": "f5",
        "when": "resourceExtname == .ino && !inDebugMode"
      }
    ],
    "debuggers": [
      {
        "type": "ardudebug",
        "label": "ArduDebug",
        "languages": [
          "cpp"
        ]
      }
    ],
    "submenus": [
      {
        "id": "ardudebug.menu",
        "label": "%submenu.label%",
        "icon": "$(circuit-board)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "cdt-gdb-adapter": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.4.0"
  },
  "icon": "images/icon.png",
  "l10n": "./l10n",
  "keywords": [
    "arduino",
    "debug",
    "avr",
    "uno",
    "breakpoint"
  ]
}
